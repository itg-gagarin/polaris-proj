# ---- Data backend -------------------------------------------------------
# file    : in-process repository seeded from fixtures, saved to DATA_FILE (default .data/db.json)
# memory  : in-process only, lost on restart
# supabase: PostgreSQL (DATABASE_URL below; run supabase/migrations first)
# auto    : supabase when DATABASE_URL (or POSTGRES_URL) is set, else file — the web app's default
DATA_BACKEND=auto
DATA_FILE=
# verify | no-verify | off — TLS to the database (no-verify for poolers with a private CA)
DATABASE_SSL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth ---------------------------------------------------------------
# dev     : user picker with seeded users (default, no real login)
# supabase: Supabase Auth (email + Google / Microsoft SSO)
AUTH_PROVIDER=dev
# Hosted previews: one shared password in front of the whole site (the dev user picker alone is open).
SITE_PASSWORD=
# Verifies Supabase access tokens (web API + sync server). Add an `app_user_id` claim with a custom
# access token hook that reads app.members.auth_user_id.
SUPABASE_JWT_SECRET=

# ---- Realtime sync ------------------------------------------------------
# Empty = browser-only multiplayer across tabs (BroadcastChannel).
# Set to the Hocuspocus server (services/sync) for real multi-device sync.
NEXT_PUBLIC_SYNC_URL=
# Services deployment: shared secret for browser sync tokens and web → sync calls (set on all services)
SYNC_TOKEN_SECRET=
# web → sync internal base URL (Vercel injects it via the binding; set it yourself elsewhere)
SYNC_URL=
# Public WebSocket URL or same-origin path for browsers (defaults to /sync/ws when SYNC_URL is set)
SYNC_PUBLIC_URL=
SYNC_PORT=1234
# Draft snapshot + server check run interval (PRD §11)
SNAPSHOT_MS=30000

# ---- AI (Claude API) ----------------------------------------------------
# mock  : deterministic local provider (default; nothing leaves the machine)
# claude: Claude API from the server/worker only
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000

# ---- Jobs ---------------------------------------------------------------
# memory | postgres (uses DATABASE_URL and app.jobs)
QUEUE_BACKEND=memory
DATABASE_URL=

# ---- Integrations (phase 6, all off until the open questions are answered)
# none | file (payloads stored as files for the ERP team) | rest
ERP_PROVIDER=none
ERP_URL=
ERP_TOKEN=
CHAT_PROVIDER=none
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WEBHOOK_SIGNING_SECRET=
# JSON array of {id,url,events,secret,active}; until a settings UI stores them per workspace
WEBHOOK_SUBSCRIPTIONS=[]
APP_BASE_URL=http://localhost:3000
