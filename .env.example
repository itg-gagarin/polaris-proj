# ---- Data backend -------------------------------------------------------
# memory  : in-process repository seeded from fixtures, snapshotted to .data/db.json (default)
# supabase: PostgreSQL via Supabase (run supabase/migrations first)
DATA_BACKEND=memory
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth ---------------------------------------------------------------
# dev     : user picker with seeded users (default, no real login)
# supabase: Supabase Auth (email + Google / Microsoft SSO)
AUTH_PROVIDER=dev

# ---- Realtime sync ------------------------------------------------------
# Empty = browser-only multiplayer across tabs (BroadcastChannel).
# Set to the Hocuspocus server (services/sync) for real multi-device sync.
NEXT_PUBLIC_SYNC_URL=
SYNC_PORT=1234
SYNC_SNAPSHOT_SECONDS=30

# ---- AI (Claude API) ----------------------------------------------------
# mock  : deterministic local provider (default; nothing leaves the machine)
# claude: Claude API from the server/worker only
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000

# ---- Jobs ---------------------------------------------------------------
# memory | postgres (uses DATABASE_URL and app.jobs)
QUEUE_BACKEND=memory
DATABASE_URL=

# ---- Integrations (phase 6, all off until the open questions are answered)
# none | file (payloads stored as files for the ERP team) | rest
ERP_PROVIDER=none
ERP_URL=
ERP_TOKEN=
CHAT_PROVIDER=none
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WEBHOOK_SIGNING_SECRET=
# JSON array of {id,url,events,secret,active}; until a settings UI stores them per workspace
WEBHOOK_SUBSCRIPTIONS=[]
APP_BASE_URL=http://localhost:3000
