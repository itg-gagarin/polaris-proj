{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "sync", "format": "url", "env": "SYNC_URL" }]
    },
    "sync": {
      "root": ".",
      "framework": "container",
      "runtime": "container",
      "entrypoint": "services/sync/Dockerfile"
    },
    "worker": {
      "root": ".",
      "framework": "container",
      "runtime": "container",
      "entrypoint": "services/worker/Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/sync/(.*)", "destination": { "service": "sync" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
