# Container image for the `sync` service (Hocuspocus, services/sync) — vercel.json entrypoint.
# It lives at the repo root because Vercel builds with the Dockerfile's folder as the build context,
# and the image needs the whole workspace. (The worker's image is Containerfile.vercel; the root
# Dockerfile is the all-in-one web app for other Docker hosts.)
ARG BASE_IMAGE=node:22-slim
FROM ${BASE_IMAGE}

ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY scripts/package.json scripts/
COPY packages ./packages
COPY services ./services
# Schema migrations, and the demo seed for standalone runs (never fixtures/private, see .dockerignore).
COPY supabase ./supabase
COPY fixtures ./fixtures
RUN pnpm install --frozen-lockfile --filter @bom/sync... && chmod -R a+rX /app

ENV NODE_ENV=production PORT=1234
USER node
EXPOSE 1234
CMD ["pnpm", "--filter", "@bom/sync", "start"]
